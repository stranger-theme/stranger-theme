{
  "name": "stranger-theme",
  "version": "1.0.3",
  "description": "A dark theme collection inspired by Stranger Things - All platforms",
  "scripts": {
    "build": "node scripts/build-all.js",
    "build:vscode": "cd visual-studio-code && npm run build",
    "build:jetbrains": "cd jetbrains && npm run build",
    "build:vim": "cd vim && npm run build",
    "build:sublime": "cd sublime-text && npm run build",
    "build:terminal": "cd terminal && npm run build",
    "build:hyper": "cd hyper && npm run build",
    "build:zed": "cd zed && npm run build",
    "test": "node scripts/test-new-clients.js && node scripts/test-openvsx-workflow.js"
  },
  "keywords": [
    "theme",
    "stranger-things",
    "dark-theme",
    "vscode",
    "jetbrains",
    "vim",
    "neovim",
    "sublime-text",
    "alacritty",
    "iterm2",
    "windows-terminal",
    "hyper",
    "ghostty",
    "kitty",
    "wezterm",
    "zed"
  ],
  "author": "Stranger Theme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stranger-theme/stranger-theme.git"
  }
}
